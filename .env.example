DATABASE_URL="mysql://root:@localhost:3306/bakery_pos"
SESSION_PASSWORD="complex_password_at_least_32_characters_long"

# Email (SMTP) — required for automated daily reports
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"

# Fallback report recipient if Store Settings reportEmail is not set
REPORT_EMAIL="admin@yourbakery.com"

# Secret to secure the cron endpoint (pass as Authorization: Bearer <secret>)
CRON_SECRET="your-secure-cron-secret-here"
