# Production Environment Variables for Electron Desktop App
# These are defaults that will be overridden by Electron's process.env

# MySQL Database (for online sync - optional, app works offline)
DATABASE_URL="mysql://root:@localhost:3306/bakery_pos"

# Session Password
SESSION_PASSWORD="complex_password_at_least_32_characters_long_for_production"

# Local SQLite Database (for offline-first operations)
# This will be automatically set by Electron main process to userData path
# Default placeholder for build - will be overridden at runtime
LOCAL_DATABASE_URL="file:./bakery-pos-local.db"

# Email (SMTP) — required for automated daily reports
# Configure these for your email provider
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"

# Fallback report recipient if Store Settings reportEmail is not set
REPORT_EMAIL="admin@yourbakery.com"

# Secret to secure the cron endpoint (pass as Authorization: Bearer <secret>)
CRON_SECRET="your-secure-cron-secret-here-for-production"
