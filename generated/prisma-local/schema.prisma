generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-local"
}

datasource db {
  provider = "sqlite"
  url      = env("LOCAL_DATABASE_URL")
}

// Local User (for offline authentication)
model LocalUser {
  id              Int       @id @default(autoincrement())
  cloudId         Int       @unique // ID from cloud database
  username        String    @unique
  password        String
  role            String // "ADMIN", "CASHIER", "MANAGER", "KITCHEN"
  status          String    @default("ACTIVE") // "ACTIVE", "INACTIVE"
  pinCode         String?   @unique
  canUnlockScreen Boolean   @default(false)
  lastLoginAt     DateTime?
  lastSyncedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([username])
  @@index([pinCode])
  @@index([cloudId])
}

// Sync Queue Model for tracking pending operations
model SyncQueue {
  id        String   @id @default(cuid())
  operation String // "CREATE", "UPDATE", "DELETE"
  tableName String // "Order", "Product", "GRN", etc.
  recordId  String? // Local record ID
  payload   String // JSON payload of the record
  status    String   @default("PENDING") // "PENDING", "SYNCED", "FAILED"
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tableName])
}

// Local Order (for offline POS operations)
model LocalOrder {
  id               Int      @id @default(autoincrement())
  productId        Int
  quantity         Int
  subtotal         Float?
  tax              Float?   @default(0)
  discount         Float?   @default(0)
  totalPrice       Float
  paymentMethod    String
  customerName     String?
  customerPhone    String?
  cardAuthCode     String?
  cardType         String?
  qrRefNo          String?
  shiftId          Int?
  orderSource      String   @default("STORE_POS")
  deliveryOrderId  String?
  deliveryPlatform String?
  commission       Float?   @default(0)
  isSynced         Boolean  @default(false)
  cloudOrderId     Int? // ID from cloud after sync
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isSynced])
  @@index([createdAt])
}

// Local Product Cache (for offline product lookup)
model LocalProduct {
  id            Int      @id @default(autoincrement())
  cloudId       Int      @unique // ID from cloud database
  name          String
  category      String?
  categoryId    Int?
  subCategoryId Int?
  costPrice     Float
  sellingPrice  Float
  packagingCost Float?   @default(0)
  currentStock  Int      @default(0)
  reorderLevel  Int?     @default(10)
  supplierId    Int
  imageUrl      String?
  productType   String?
  trackStock    Boolean  @default(true)
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cloudId])
  @@index([lastSyncedAt])
}

// Local Category Cache
model LocalCategory {
  id           Int      @id @default(autoincrement())
  cloudId      Int      @unique
  name         String
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  color        String?
  imageUrl     String?
  taxRate      Float?   @default(0)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cloudId])
}

// Local SubCategory Cache
model LocalSubCategory {
  id           Int      @id @default(autoincrement())
  cloudId      Int      @unique
  name         String
  categoryId   Int
  displayOrder Int      @default(0)
  color        String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categoryId, name])
  @@index([cloudId])
}

// Local GRN (for offline GRN operations)
model LocalGRN {
  id              Int       @id @default(autoincrement())
  invoiceNumber   String?
  poNumber        String?
  paymentType     String?
  creditPeriod    Int?
  dueDate         DateTime?
  receivedDate    DateTime  @default(now())
  productId       Int
  quantity        Int
  freeQuantity    Int?      @default(0)
  uom             String?
  unitCost        Float
  discount        Float?    @default(0)
  discountType    String?
  landedCost      Float?    @default(0)
  freightCost     Float?    @default(0)
  handlingCost    Float?    @default(0)
  taxCost         Float?    @default(0)
  trueUnitCost    Float?
  totalAmount     Float?    @default(0)
  balanceAmount   Float?    @default(0)
  expiryDate      DateTime?
  batchNumber     String?
  qcStatus        String?   @default("Passed")
  rejectedQty     Int?      @default(0)
  rejectionReason String?
  paymentStatus   String    @default("PENDING")
  paidAmount      Float?    @default(0)
  supplierId      Int
  categoryId      Int?
  subCategoryId   Int?
  isSynced        Boolean   @default(false)
  cloudGRNId      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isSynced])
  @@index([receivedDate])
}

// Sync Metadata
model SyncMetadata {
  id                 String    @id @default(cuid())
  lastSyncAt         DateTime  @default(now())
  lastSuccessfulSync DateTime?
  syncStatus         String    @default("IDLE") // "IDLE", "SYNCING", "ERROR"
  pendingCount       Int       @default(0)
  failedCount        Int       @default(0)
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
