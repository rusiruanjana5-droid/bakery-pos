{
  "name": "bakery-pos",
  "productName": "RAK-System-Bakery-POS",
  "version": "0.1.0",
  "description": "Professional Point of Sale system for bakery operations with offline-first capabilities",
  "author": "RAK System",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "tsx scripts/pre-migration-backup.ts && prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "db:local:generate": "prisma generate --schema=prisma/schema-local.prisma",
    "db:local:push": "tsx scripts/pre-migration-backup.ts && prisma db push --schema=prisma/schema-local.prisma",
    "db:local:studio": "prisma studio --schema=prisma/schema-local.prisma",
    "db:local:init": "tsx scripts/init-sqlite-db.ts",
    "backup:create": "tsx scripts/create-backup.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "backup:list": "tsx scripts/list-backups.ts",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development PORT=3000 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "dist": "npm run electron:build:win"
  },
  "main": "electron/main.js",
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "exceljs": "^4.4.0",
    "iron-session": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.25.0",
    "next": "15.1.6",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8",
    "prisma": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
